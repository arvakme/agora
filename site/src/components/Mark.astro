---
// 站点标志：两块节点框和一条连线，右上节点上站着一个小人（Agora 画布里 agent 的指针）
interface Props {
	size?: number;
}
const { size = 24 } = Astro.props;
---

<svg class="mark" width={size} height={size} viewBox="0 0 32 32" fill="none" aria-hidden="true">
	<rect x="2.5" y="17.5" width="12" height="9" rx="2.5" stroke="currentColor" stroke-width="2"></rect>
	<rect x="17.5" y="11.5" width="12" height="9" rx="2.5" stroke="currentColor" stroke-width="2"></rect>
	<path d="M14.5 21.5 C 16 21.5 16 16 17.5 16" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
	<circle cx="23.5" cy="3.6" r="2.1" fill="var(--amber)"></circle>
	<path d="M23.5 5.8v3.4M21.4 11.5l2.1-2.3 2.1 2.3M21.6 7.2h3.8" stroke="var(--amber)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
</svg>
