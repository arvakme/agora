---
import { BANNER_SIZES, bannerImages } from "../banner";

// 首屏横幅：墨迹从地平线的落日光洇开，揭示完后天上的星座架构图再亮一下（与 docs/assets/banner-ink.svg 同一个画面）。
// 不用 <img src="banner-ink.svg">：那份把 1 MB 位图 base64 嵌在 SVG 里；浏览器会复用同一 URL 的 SVG 文档，
// 动画时间线跟着复用，从英文页切到中文页时横幅直接是揭示完的样子；而且它每帧都对 2400×800 重算 feTurbulence
// 位移滤镜，实测只有 15 fps。这里把揭示写进页面：
// - 底图是普通的响应式 <picture>（avif/webp 多档，按渲染宽度挑），首屏预加载；
// - 揭示只用合成器能做的事：一个方形「洞」盖在落日处，每帧只改它的 transform: scale(s)，洞里的底图反向 scale(1/s)
//   保持不动，于是露出来的范围越长越大，整个过程不重绘、不重排（无 GPU 的无头浏览器里也稳在 60 fps）；
// - 墨迹毛边：同一套 feTurbulence + feDisplacementMap 在加载时只算一次，画成一张「中间镂空、边缘毛糙」的夜色遮片，
//   放在洞里跟着一起放大，盖住洞的方边，露出来的就是一团洇开的墨；
// - 揭示完换回 <img>；星座架构图的亮光是一层只算一次滤镜的 SVG，只动 opacity；
// - 每次加载页面、从往返缓存回来、第一次滚进视口时都从头播；减少动效或脚本没跑时直接显示静态底图。
interface Props {
	alt: string;
}
const { alt } = Astro.props;
const { avif, webp, fallback } = await bannerImages();
const W = 2400;
const H = 800;
---

<figure class="ink-banner" data-ink>
	<picture>
		<source type="image/avif" srcset={avif} sizes={BANNER_SIZES} />
		<source type="image/webp" srcset={webp} sizes={BANNER_SIZES} />
		<img class="still" src={fallback} alt={alt} width={W} height={H} fetchpriority="high" decoding="async" />
	</picture>
	<div class="hole" aria-hidden="true">
		<img class="hole-art" alt="" decoding="async" />
		<canvas class="fringe" width="800" height="800"></canvas>
	</div>
	<!-- 星座架构图的亮光：只留下天上亮暖色的像素（线、节点框、小人）再柔化，滤镜只在第一次绘制时算 -->
	<svg class="glow" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
		<defs>
			<filter id="ink-lines" x="0" y="0" width="100%" height="100%" color-interpolation-filters="sRGB">
				<feColorMatrix type="matrix" values="1.25 0 0 0 0.05  0 1.2 0 0 0.04  0 0 1.1 0 0  4.2 3.6 -4.8 0 -3.15" result="key"></feColorMatrix>
				<feGaussianBlur in="key" stdDeviation="2.2" result="soft"></feGaussianBlur>
				<feMerge><feMergeNode in="soft"></feMergeNode><feMergeNode in="key"></feMergeNode></feMerge>
			</filter>
			<linearGradient id="ink-skyfade" x1="0" y1="0" x2="0" y2="1">
				<stop offset="0" stop-color="white"></stop>
				<stop offset="0.42" stop-color="white"></stop>
				<stop offset="0.5" stop-color="black"></stop>
			</linearGradient>
			<mask id="ink-sky" maskUnits="userSpaceOnUse" x="0" y="0" width={W} height={H}>
				<rect width={W} height={H} fill="url(#ink-skyfade)"></rect>
			</mask>
		</defs>
		<image class="glow-art" width={W} height={H} mask="url(#ink-sky)" filter="url(#ink-lines)" preserveAspectRatio="xMidYMid slice"></image>
	</svg>
</figure>

<script>
	import { motion } from "../motion";

	// 墨迹参数与 docs/assets/banner-ink.py 一致：从 (1140, 540) 洇开，前 0.5 秒空着，6.5 秒长到盖满（缓动 0.22 0.61 0.36 1）；
	// 揭示到 5.2 秒时亮光升到 0.85，7.6 秒回落到 0.35（亮光的时间写在下面的 CSS 动画里）
	const W = 2400;
	const H = 800;
	const CX = 1140;
	const CY = 540;
	const HOLD = 500;
	const GROW = 6500;
	// 洞是 D×D 的方块；遮片里镂空的墨团半径约 0.75 D/2，毛边再往外伸一点
	const D = 800;
	const INNER = 0.72;

	const figure = document.querySelector<HTMLElement>("[data-ink]")!;
	const still = figure.querySelector<HTMLImageElement>("img.still")!;
	const hole = figure.querySelector<HTMLElement>(".hole")!;
	const holeArt = hole.querySelector<HTMLImageElement>(".hole-art")!;
	const fringe = hole.querySelector<HTMLCanvasElement>(".fringe")!;
	const glowArt = figure.querySelector<SVGImageElement>(".glow-art")!;

	// cubic-bezier(x1, y1, x2, y2) 的 y(x)：牛顿迭代解 x(t) = x
	const bezier = (x1: number, y1: number, x2: number, y2: number) => (x: number) => {
		const at = (a: number, b: number, t: number) => 3 * a * t * (1 - t) ** 2 + 3 * b * t * t * (1 - t) + t ** 3;
		let t = x;
		for (let i = 0; i < 6; i++) {
			const dx = at(x1, x2, t) - x;
			const d = 3 * x1 * (1 - t) ** 2 + 6 * (x2 - x1) * t * (1 - t) + 3 * (1 - x2) * t * t;
			if (Math.abs(dx) < 1e-4 || !d) break;
			t -= dx / d;
		}
		return at(y1, y2, Math.min(1, Math.max(0, t)));
	};
	const ease = bezier(0.22, 0.61, 0.36, 1);

	// 夜色遮片：满幅夜空底色，中间用湍流位移过的圆镂空，边缘再糊开一点。浏览器在 <img> 里算一次 SVG 滤镜，画进 canvas 定格
	function paintFringe() {
		const r = (D / 2) * INNER;
		const svg = `<svg xmlns="http://www.w3.org/2000/svg" width="${D}" height="${D}" viewBox="0 0 ${D} ${D}"><filter id="f" x="-30%" y="-30%" width="160%" height="160%"><feTurbulence type="fractalNoise" baseFrequency="0.05" numOctaves="3" seed="11"/><feDisplacementMap in="SourceGraphic" scale="38" xChannelSelector="R" yChannelSelector="G" result="d"/><feGaussianBlur in="d" stdDeviation="1.5"/></filter><mask id="m"><rect width="${D}" height="${D}" fill="#fff"/><circle cx="${D / 2}" cy="${D / 2}" r="${r}" fill="#000" filter="url(#f)"/></mask><rect width="${D}" height="${D}" fill="#15132a" mask="url(#m)"/></svg>`;
		const img = new Image();
		img.src = `data:image/svg+xml,${encodeURIComponent(svg)}`;
		return img.decode().then(() => fringe.getContext("2d")!.drawImage(img, 0, 0));
	}

	let raf = 0;
	function play() {
		cancelAnimationFrame(raf);
		// 底图按 object-fit: cover、object-position 47.5% 50% 摆放，手机上裁成 4:3 时落日仍在洞的中心
		const box = figure.getBoundingClientRect();
		const scale = Math.max(box.width / W, box.height / H);
		const dx = (box.width - W * scale) * 0.475;
		const dy = (box.height - H * scale) * 0.5;
		const cx = dx + CX * scale;
		const cy = dy + CY * scale;
		const left = cx - D / 2;
		const top = cy - D / 2;
		Object.assign(hole.style, { left: `${left}px`, top: `${top}px`, width: `${D}px`, height: `${D}px` });
		Object.assign(holeArt.style, {
			left: `${dx - left}px`,
			top: `${dy - top}px`,
			width: `${W * scale}px`,
			height: `${H * scale}px`,
			transformOrigin: `${cx - dx}px ${cy - dy}px`,
		});
		// 长到墨团盖住最远的角再多一成
		const far = Math.max(Math.hypot(cx, cy), Math.hypot(box.width - cx, cy), Math.hypot(cx, box.height - cy), Math.hypot(box.width - cx, box.height - cy));
		const end = (far / ((D / 2) * INNER)) * 1.1;
		// 先清掉状态再进 play，亮光的 CSS 动画才会从头开始
		figure.dataset.ink = "";
		void figure.offsetWidth;
		figure.dataset.ink = "play";
		const start = performance.now();
		const draw = (now: number) => {
			const t = now - start - HOLD;
			const s = Math.max(0.002, ease(Math.min(1, Math.max(0, t) / GROW)) * end);
			hole.style.transform = `scale(${s})`;
			holeArt.style.transform = `scale(${1 / s})`;
			hole.style.visibility = t > 0 ? "visible" : "hidden";
			if (t < GROW) raf = requestAnimationFrame(draw);
			else figure.dataset.ink = "done";
		};
		raf = requestAnimationFrame(draw);
	}

	if (motion) {
		const loaded = new Promise<void>((done, fail) => {
			if (still.complete && still.naturalWidth) done();
			else {
				still.addEventListener("load", () => done(), { once: true });
				still.addEventListener("error", fail, { once: true });
			}
		});
		const ready = Promise.all([loaded, paintFringe()]).then(() => {
			// 洞里和亮光层用的都是底图已经下载好的那一档（命中缓存）
			const src = still.currentSrc || still.src;
			holeArt.src = src;
			glowArt.setAttribute("href", src);
			return holeArt.decode();
		});
		ready.catch(() => (figure.dataset.ink = "static"));
		let played = false;
		new IntersectionObserver(([entry]) => {
			if (!entry.isIntersecting || played) return;
			played = true;
			ready.then(play, () => {});
		}).observe(figure);
		// 从往返缓存回到这一页（浏览器后退）时也重播一遍
		addEventListener("pageshow", (event) => {
			if (event.persisted) ready.then(play, () => {});
		});
	} else {
		figure.dataset.ink = "static";
	}
</script>

<style>
	.ink-banner {
		position: relative;
		overflow: hidden;
		aspect-ratio: 3 / 1;
		background: #15132a;
	}

	picture,
	.still,
	.glow {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
	}

	.still {
		object-fit: cover;
		object-position: 47.5% 50%;
	}

	.hole,
	.glow {
		display: none;
		pointer-events: none;
	}

	.hole {
		position: absolute;
		overflow: hidden;
		transform-origin: 50% 50%;
		will-change: transform;
	}

	.hole-art,
	.fringe {
		position: absolute;
		max-width: none;
	}

	.hole-art {
		will-change: transform;
	}

	.fringe {
		inset: 0;
		width: 100%;
		height: 100%;
	}

	/* 允许动效时：揭示开始前框里是夜空底色，揭示中由放大的圆孔（合成层变换）画，揭示完换回 <img> */
	:global(html.motion) [data-ink=""] .still,
	:global(html.motion) [data-ink="play"] .still {
		opacity: 0;
	}

	:global(html.motion) [data-ink="play"] .hole {
		display: block;
	}

	/* 亮光：揭示开始就挂上（opacity 0），5.2 秒升到 0.85，7.6 秒回落到 0.35，之后停在那里 */
	:global(html.motion) :is([data-ink="play"], [data-ink="done"]) .glow {
		display: block;
		/* 不用 mix-blend-mode：混合模式每帧都要和底下重新混一次；抠出来的亮线本身带透明度，正常叠加看起来几乎一样 */
		will-change: opacity;
		animation: glow 7.6s cubic-bezier(0.3, 0, 0.2, 1) both;
	}

	@keyframes glow {
		0%,
		68.4% {
			opacity: 0;
		}
		79.5% {
			opacity: 0.85;
		}
		100% {
			opacity: 0.35;
		}
	}

	@media (max-width: 640px) {
		.ink-banner {
			aspect-ratio: 4 / 3;
		}
	}
</style>
