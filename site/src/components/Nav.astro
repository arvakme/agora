---
import { REPO, href, other, site, type Lang } from "../i18n";
import Mark from "./Mark.astro";
import { copy } from "./Nav.copy";

interface Props {
	lang: Lang;
}
const { lang } = Astro.props;
const t = site[lang];
const c = copy[lang];
const to = site[other(lang)];
---

<header class="nav">
	<a class="brand" href={href(t.home)} aria-label={c.home}><Mark size={26} /><span>Agora</span></a>
	<nav class="links" aria-label={c.label}>
		<a class="section-link" href="#film">{c.film}</a>
		<a class="section-link" href="#how">{c.how}</a>
		<a class="section-link" href="#features">{c.features}</a>
		<a class="section-link" href="#start">{c.start}</a>
		<a class="lang" href={href(to.home)} hreflang={to.tag} lang={to.tag} title={t.switchTitle}>{t.switchLabel}</a>
		<a class="icon" href={REPO} aria-label="GitHub" title="GitHub">
			<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"></path></svg>
		</a>
	</nav>
</header>

<script>
	// 离开页顶后垫一层半透明底，免得链接压在内容上
	const nav = document.querySelector<HTMLElement>(".nav")!;
	const sync = () => nav.toggleAttribute("data-scrolled", scrollY > 8);
	addEventListener("scroll", sync, { passive: true });
	sync();
</script>

<style>
	.nav {
		position: fixed;
		inset: 0 0 auto;
		z-index: 10;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		height: var(--nav-h);
		padding-inline: max(var(--gutter), (100% - var(--page-max)) / 2);
	}

	.nav::before {
		content: "";
		position: absolute;
		inset: 0;
		z-index: -1;
		background: color-mix(in oklch, var(--bg) 78%, transparent);
		box-shadow: 0 1px 0 var(--ring);
		backdrop-filter: blur(14px) saturate(1.3);
		opacity: 0;
		transition: opacity 240ms var(--ease);
	}

	.nav[data-scrolled]::before {
		opacity: 1;
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		padding: 6px;
		margin: -6px;
		border-radius: 10px;
		text-decoration: none;
		font-family: var(--font-display);
		font-size: 1.35rem;
		font-weight: 560;
		font-variation-settings: "SOFT" 80;
		letter-spacing: -0.01em;
	}

	.links {
		display: flex;
		align-items: center;
		gap: 2px;
	}

	.links a {
		display: grid;
		place-items: center;
		min-width: 40px;
		height: 40px;
		padding: 0 12px;
		border-radius: 10px;
		color: var(--muted);
		font-size: 14.5px;
		font-weight: 500;
		text-decoration: none;
		white-space: nowrap;
		transition:
			color var(--duration-state) var(--ease),
			background-color var(--duration-state) var(--ease);
	}

	.links .lang {
		margin-left: 8px;
		box-shadow: 0 0 0 1px var(--ring);
		color: var(--fg);
	}

	.links .icon {
		padding: 0;
	}

	.links svg {
		width: 19px;
		height: 19px;
	}

	@media (hover: hover) and (pointer: fine) {
		.links a:hover {
			color: var(--fg);
			background: var(--hover);
		}
	}

	@media (max-width: 860px) {
		.section-link {
			display: none !important;
		}
	}
</style>
