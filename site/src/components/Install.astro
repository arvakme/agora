---
import { INSTALL, site, type Lang } from "../i18n";

// 安装命令与复制按钮；Hero 与收尾共用。复制逻辑用事件委托只挂一次：任何带 data-copy-install 的按钮都复制命令、
// 置 data-state="done"，并把 data-copied 写进紧随其后的 aria-live 节点；剪贴板被拒时播报 data-failed 并选中命令文字
interface Props {
	lang: Lang;
	class?: string;
}
const { lang, class: className } = Astro.props;
const t = site[lang];
---

<div class:list={["install", className]}>
	<code>{INSTALL}</code>
	<button type="button" class="copy" aria-label={t.copy} title={t.copy} data-copy-install data-copied={t.copied} data-failed={t.copyFailed}>
		<svg class="icon-copy" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="14" height="14" x="8" y="8" rx="2"></rect><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path></svg>
		<svg class="icon-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg>
	</button>
	<span class="sr-only" aria-live="polite"></span>
</div>

<script>
	import { INSTALL } from "../i18n";

	const COPIED_MS = 1600;
	const timers = new WeakMap<HTMLButtonElement, number>();

	document.addEventListener("click", async (event) => {
		const button = (event.target as Element).closest<HTMLButtonElement>("[data-copy-install]");
		if (!button) return;
		const live = button.nextElementSibling!;
		const copied = await navigator.clipboard?.writeText(INSTALL).then(
			() => true,
			() => false,
		);
		if (!copied) {
			live.textContent = button.dataset.failed!;
			const code = button.parentElement!.querySelector("code");
			if (code) getSelection()!.selectAllChildren(code);
			return;
		}
		button.dataset.state = "done";
		live.textContent = button.dataset.copied!;
		clearTimeout(timers.get(button));
		timers.set(
			button,
			window.setTimeout(() => {
				delete button.dataset.state;
				live.textContent = "";
			}, COPIED_MS),
		);
	});
</script>

<style>
	.install {
		display: flex;
		align-items: center;
		gap: 8px;
		max-width: 100%;
		padding: 7px 7px 7px 18px;
		border-radius: 14px;
		background: var(--code-bg);
		color: var(--code-fg);
		box-shadow:
			0 0 0 1px oklch(1 0 0 / 0.08) inset,
			0 18px 40px -22px oklch(0.2 0.05 290 / 0.6);
	}

	code {
		/* 放不下时命令横向滚动，按钮不缩 */
		min-width: 0;
		overflow-x: auto;
		scrollbar-width: none;
		font-size: 14.5px;
		white-space: nowrap;
	}

	/* 提示符画在样式里：不进读屏，也不进复制或选中的文字 */
	code::before {
		content: "$";
		margin-right: 10px;
		color: var(--code-prompt);
	}

	.copy {
		flex: none;
		display: grid;
		place-items: center;
		width: 38px;
		height: 38px;
		border: 0;
		border-radius: 10px;
		background: oklch(1 0 0 / 0.08);
		color: var(--code-fg);
		cursor: pointer;
		transition:
			background-color var(--duration-state) var(--ease),
			scale 100ms var(--ease);
	}

	.copy svg {
		grid-area: 1 / 1;
		width: 17px;
		height: 17px;
		transition: opacity var(--duration-state) var(--ease);
	}

	.icon-check,
	.copy[data-state="done"] .icon-copy {
		opacity: 0;
	}

	.copy[data-state="done"] .icon-check {
		opacity: 1;
		color: var(--code-prompt);
	}

	.copy:active {
		scale: 0.92;
	}

	@media (hover: hover) and (pointer: fine) {
		.copy:hover {
			background: oklch(1 0 0 / 0.16);
		}
	}

	@media (max-width: 480px) {
		code {
			font-size: 12.5px;
		}
	}
</style>
