---
import Install from "../components/Install.astro";
import { REPO, blob, type Lang } from "../i18n";
import { copy } from "./Start.copy";

interface Props {
	lang: Lang;
}
const { lang } = Astro.props;
const t = copy[lang];
---

<section class="section start dotted" id="start" aria-labelledby="start-title">
	<div class="section-inner">
		<div class="head">
			<p class="eyebrow">{t.eyebrow}</p>
			<h2 class="section-title" id="start-title" set:html={t.title} />
			<p class="section-lede">{t.lede}</p>
			<Install lang={lang} class="big" />
		</div>

		<div class="term" role="group" aria-label="agora">
			<div class="term-bar" aria-hidden="true"><i></i><i></i><i></i><span>~/code/my-service</span></div>
			<pre><code>{
				t.commands.map(([cmd, note]) => (
					<span class="cmdline"><span class="cmd">{cmd}</span>{note && <span class="note"># {note}</span>}{"\n"}</span>
				))
			}</code></pre>
		</div>

		<div class="facts">
			<div>
				<h3 class="item-title">{t.needsTitle}</h3>
				<ul>{t.needs.map((item) => <li set:html={item} />)}</ul>
			</div>
			<div>
				<h3 class="item-title">{t.limitsTitle}</h3>
				<ul>{t.limits.map((item) => <li set:html={item} />)}</ul>
			</div>
		</div>

		<div class="cta">
			<a class="button primary" href={REPO}>
				<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2.5l2.94 5.96 6.58.96-4.76 4.64 1.12 6.55L12 17.52l-5.88 3.09 1.12-6.55L2.48 9.42l6.58-.96L12 2.5z"></path></svg>
				{t.github}
			</a>
			<a class="button" href={blob("README.md")}>{t.readme} <span aria-hidden="true">→</span></a>
		</div>
	</div>
</section>

<style>
	.head {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
	}

	.head :global(.install.big) {
		margin-top: 32px;
	}

	.term {
		max-width: 820px;
		margin: clamp(40px, 5vw, 64px) auto 0;
		overflow: hidden;
		border-radius: var(--radius);
		background: var(--code-bg);
		color: var(--code-fg);
		box-shadow:
			0 0 0 1px oklch(1 0 0 / 0.06) inset,
			0 30px 80px -30px oklch(0.2 0.05 290 / 0.6);
	}

	.term-bar {
		display: flex;
		align-items: center;
		gap: 6px;
		height: 34px;
		padding-inline: 14px;
		border-bottom: 1px solid oklch(1 0 0 / 0.08);
		color: var(--code-muted);
		font-family: var(--font-mono);
		font-size: 12px;
	}

	.term-bar i {
		width: 10px;
		height: 10px;
		border-radius: 50%;
		background: oklch(1 0 0 / 0.16);
	}

	.term-bar span {
		margin-left: auto;
	}

	pre {
		overflow-x: auto;
		padding: 20px 22px 22px;
		font-size: 14px;
		line-height: 1.95;
	}

	.cmdline {
		display: block;
	}

	.cmd::before {
		content: "$ ";
		color: var(--code-prompt);
	}

	.note {
		margin-left: 2ch;
		color: var(--code-muted);
	}

	/* 窄屏：注释换到命令下一行 */
	@media (max-width: 720px) {
		.note {
			display: block;
			margin-left: 2ch;
			line-height: 1.5;
			white-space: normal;
		}

		.cmdline + .cmdline {
			margin-top: 6px;
		}

		pre {
			font-size: 13px;
		}
	}

	.facts {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: clamp(24px, 4vw, 56px);
		max-width: 980px;
		margin: clamp(48px, 6vw, 80px) auto 0;
	}

	.facts ul {
		display: grid;
		gap: 12px;
		margin-top: 16px;
		padding-left: 1.1em;
		color: var(--muted);
		line-height: 1.6;
	}

	.facts li::marker {
		color: var(--amber);
	}

	.facts :global(code) {
		font-size: 0.86em;
	}

	.facts a {
		color: var(--fg);
	}

	.cta {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 12px;
		margin-top: clamp(48px, 6vw, 72px);
	}

	.button {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		min-height: 48px;
		padding: 0 22px;
		border-radius: 999px;
		box-shadow: 0 0 0 1px var(--ring);
		background: var(--bg-raised);
		font-weight: 600;
		text-decoration: none;
		transition:
			background-color var(--duration-state) var(--ease),
			scale 100ms var(--ease);
	}

	.button.primary {
		background: var(--fg);
		color: var(--bg);
		box-shadow: none;
	}

	.button svg {
		width: 18px;
		height: 18px;
		color: var(--amber);
	}

	.button:active {
		scale: 0.97;
	}

	@media (hover: hover) and (pointer: fine) {
		.button:hover {
			background: var(--hover);
		}

		.button.primary:hover {
			background: color-mix(in oklch, var(--fg) 85%, var(--accent));
		}
	}

	@media (max-width: 720px) {
		.facts {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
