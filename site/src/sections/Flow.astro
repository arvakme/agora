---
import Shot from "../components/Shot.astro";
import type { Lang } from "../i18n";
import { copy } from "./Flow.copy";

interface Props {
	lang: Lang;
}
const { lang } = Astro.props;
const t = copy[lang];
const AGENTS = ["Pi", "Claude Code", "Codex", "Grok", "Cursor", "Devin"];
const play = lang === "zh" ? { play: "播放", pause: "暂停" } : { play: "Play", pause: "Pause" };
---

<section class="section flow" id="how" aria-labelledby="how-title">
	<div class="section-inner">
		<p class="eyebrow" data-reveal="soft">{t.eyebrow}</p>
		<h2 class="section-title" id="how-title" data-reveal="wipe" set:html={t.title} />
		<p class="section-lede" data-reveal>{t.lede}</p>

		<!--
			一幕钉住的故事（学 firecode 的 Agents / Review）：宽屏且允许动效时，轨道比一屏高，钉住层 sticky 停在导航下面，
			往下滚推进三拍：01 agent 写日志 → 02 服务跟随 → 03 画布更新，对应的站点亮起、车道开始走包、下面的说明换成当前那一拍。
			窄屏或减少动效时不钉住，三拍平铺，所有站点都亮着。
		-->
		<div class="story" data-story>
			<div class="pin">
				<figure class="diagram dotted" data-beat="0" aria-label={t.lede}>
					<div class="track">
						{
							t.stations.map((station, i) => (
								<>
									<div class:list={["station", { hub: i === 1 }]} data-step={i + 1}>
										<span class="num">0{i + 1}</span>
										<strong>{station.name}</strong>
										<span class="meta">{station.meta}</span>
									</div>
									{i < t.links.length && (
										<div class:list={["link", { live: i === 0 }]} data-step={i + 2} aria-hidden="true">
											<span class="top">{t.links[i].top}</span>
											<span class="wire">
												<i />
											</span>
											<span class="bottom">{t.links[i].bottom}</span>
										</div>
									)}
								</>
							))
						}
					</div>
					<span class="rail" aria-hidden="true"><span class="rail-fill"></span></span>
					<ol class="beats">
						{
							t.beats.map((beat, i) => (
								<li class="beat" data-step={i + 1}>
									<span class="beat-num">0{i + 1}</span>
									<h3 class="beat-title">{beat.title}</h3>
									<p set:html={beat.body} />
								</li>
							))
						}
					</ol>
				</figure>
			</div>
		</div>

		<div class="split">
			<div class="text">
				<ul class="points">
					{
						t.points.map((point) => (
							<li data-reveal>
								<strong>{point.title}</strong> <span set:html={point.body} />
							</li>
						))
					}
				</ul>
				<h3 class="item-title agents-title" data-reveal="wipe">{t.agentsTitle}</h3>
				<ul class="agents">
					{AGENTS.map((name) => <li data-reveal="soft">{name}</li>)}
				</ul>
				<p class="note" data-reveal set:html={t.agentsNote} />
			</div>
			<figure class="panel">
				<Shot lang={lang} clip="live-panel" bare alt={t.panelAlt} sizes="(max-width: 900px) min(92vw, 520px), 480px" widths={[480, 720]} labels={play} />
				<figcaption data-reveal>{t.panelCaption}</figcaption>
			</figure>
		</div>
	</div>
</section>

<script>
	import { clamp, motion, scene } from "../motion";

	// 钉住推进：轨道顶到钉住位置时进度 0，轨道底离开时 1；三拍各占三分之一。只在宽屏、允许动效时启用
	const story = document.querySelector<HTMLElement>("[data-story]")!;
	const diagram = story.querySelector<HTMLElement>(".diagram")!;
	const wide = matchMedia("(min-width: 900px)");
	if (motion) {
		let beat = -1;
		// 钉住层的 top 与高度只在尺寸变化时量一次，滚动循环里只读轨道自己的位置，不在帧里触发样式重算
		const pin = story.firstElementChild as HTMLElement;
		let pinTop = 0;
		let pinHeight = 0;
		new ResizeObserver(() => {
			pinTop = parseFloat(getComputedStyle(pin).top) || 0;
			pinHeight = pin.offsetHeight;
		}).observe(pin);
		scene(story, (rect) => {
			if (!wide.matches) {
				if (beat !== 0) diagram.dataset.beat = String((beat = 0));
				return;
			}
			const progress = clamp((pinTop - rect.top) / Math.max(1, rect.height - pinHeight));
			diagram.style.setProperty("--progress", progress.toFixed(3));
			const now = Math.min(3, 1 + Math.floor(progress * 3));
			if (now !== beat) diagram.dataset.beat = String((beat = now));
		});
	}
</script>

<style>
	/* 钉住的轨道：比一屏高出的部分就是推进三拍的滚动距离 */
	.story {
		margin-top: clamp(40px, 5vw, 64px);
	}

	@media (min-width: 900px) {
		:global(html.motion) .story {
			height: calc(100svh + 150svh);
		}

		:global(html.motion) .pin {
			position: sticky;
			top: calc(var(--nav-h) + max(16px, (100svh - var(--nav-h) - 560px) / 2));
		}
	}

	.diagram {
		padding: clamp(24px, 4vw, 48px);
		border-radius: var(--radius);
		background-color: var(--bg-raised);
		box-shadow: 0 0 0 1px var(--ring);
	}

	.track {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(120px, 0.8fr) minmax(0, 1fr) minmax(120px, 0.8fr) minmax(0, 1fr);
		align-items: center;
	}

	.station {
		display: flex;
		flex-direction: column;
		gap: 6px;
		padding: 20px 18px;
		border-radius: 14px;
		background: var(--bg);
		box-shadow:
			0 0 0 1.5px var(--fg),
			4px 4px 0 var(--faint);
		text-align: center;
	}

	.station.hub {
		box-shadow:
			0 0 0 1.5px var(--accent),
			4px 4px 0 color-mix(in oklch, var(--accent) 35%, transparent);
	}

	.num {
		color: var(--muted);
		font-family: var(--font-mono);
		font-size: 11.5px;
		letter-spacing: 0.12em;
	}

	.station strong {
		font-family: var(--font-display);
		font-size: 1.12rem;
		font-weight: 600;
		line-height: 1.25;
	}

	.meta {
		color: var(--muted);
		font-family: var(--font-mono);
		font-size: 11.5px;
		line-height: 1.5;
	}

	.link {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 8px;
		padding-inline: 10px;
		text-align: center;
	}

	.link .top {
		font-size: 13.5px;
		font-weight: 600;
	}

	.link.live .top {
		color: var(--accent);
	}

	.link .bottom {
		color: var(--muted);
		font-family: var(--font-mono);
		font-size: 11.5px;
	}

	/* 车道：虚线往前走，一个小包沿线跑过去 */
	.wire {
		position: relative;
		display: block;
		width: 100%;
		height: 2px;
		background: repeating-linear-gradient(90deg, var(--muted) 0 6px, transparent 6px 12px);
		background-size: 12px 2px;
		animation: march 900ms linear infinite;
	}

	.live .wire {
		background-image: repeating-linear-gradient(90deg, var(--accent) 0 6px, transparent 6px 12px);
	}

	.wire::after {
		content: "";
		position: absolute;
		right: -2px;
		top: 50%;
		width: 8px;
		height: 8px;
		border-top: 2px solid var(--muted);
		border-right: 2px solid var(--muted);
		translate: 0 -50%;
		rotate: 45deg;
	}

	.wire i {
		position: absolute;
		top: 50%;
		left: 0;
		width: 10px;
		height: 10px;
		border-radius: 50%;
		background: var(--amber);
		box-shadow: 0 0 10px var(--amber);
		translate: -50% -50%;
		animation: packet 2.4s var(--ease) infinite;
	}

	.link:nth-of-type(4) .wire i {
		animation-delay: 1.2s;
	}

	@keyframes march {
		to {
			background-position: 12px 0;
		}
	}

	@keyframes packet {
		0% {
			left: 0;
			opacity: 0;
		}
		10% {
			opacity: 1;
		}
		80% {
			left: 100%;
			opacity: 1;
		}
		100% {
			left: 100%;
			opacity: 0;
		}
	}

	/* 三拍的说明：每一拍放在对应站点的正下方 */
	.rail {
		display: none;
	}

	.beats {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: clamp(20px, 3vw, 40px);
		margin-top: 32px;
		padding: 24px 0 0;
		border-top: 1px dashed var(--faint);
		list-style: none;
	}

	.beat-num {
		color: var(--amber);
		font-family: var(--font-mono);
		font-size: 12px;
		font-weight: 600;
		letter-spacing: 0.1em;
	}

	.beat-title {
		margin-top: 6px;
		font-family: var(--font-display);
		font-size: 1.12rem;
		font-weight: 600;
		line-height: 1.3;
	}

	.beat p {
		margin-top: 8px;
		color: var(--muted);
		font-size: 14.5px;
		line-height: 1.6;
	}

	/* 推进中（data-beat 1–3）：没轮到的站点、车道和说明压暗，当前那一站亮起抬高；进度线跟着滚动走 */
	.diagram:not([data-beat="0"]) .rail {
		display: block;
		position: relative;
		height: 2px;
		margin-top: 32px;
		border-radius: 2px;
		background: var(--ring);
	}

	.diagram:not([data-beat="0"]) .beats {
		margin-top: 0;
		border-top: 0;
	}

	.rail-fill {
		display: block;
		height: 100%;
		border-radius: inherit;
		background: var(--accent);
		transform-origin: left;
		transform: scaleX(var(--progress, 0));
	}

	.station,
	.link,
	.beat {
		transition:
			opacity 500ms var(--ease),
			translate 500ms var(--ease),
			box-shadow 500ms var(--ease);
	}

	/* 站点和车道的 data-step 是它在第几拍亮起；没轮到的压暗，走过的保持亮着 */
	.diagram[data-beat="1"] :is(.station, .link):is([data-step="2"], [data-step="3"]),
	.diagram[data-beat="2"] :is(.station, .link)[data-step="3"] {
		opacity: 0.3;
	}

	/* 说明只亮当前这一拍 */
	.diagram[data-beat="1"] .beat:not([data-step="1"]),
	.diagram[data-beat="2"] .beat:not([data-step="2"]),
	.diagram[data-beat="3"] .beat:not([data-step="3"]) {
		opacity: 0.3;
	}

	.diagram[data-beat="1"] .station[data-step="1"],
	.diagram[data-beat="2"] .station[data-step="2"],
	.diagram[data-beat="3"] .station[data-step="3"] {
		translate: 0 -6px;
		box-shadow:
			0 0 0 1.5px var(--accent),
			4px 4px 0 color-mix(in oklch, var(--accent) 35%, transparent),
			0 18px 40px -18px color-mix(in oklch, var(--accent) 60%, transparent);
	}

	/* 车道只在轮到它（或已经走过）时走包 */
	.diagram[data-beat="1"] .wire i {
		animation-play-state: paused;
		opacity: 0;
	}

	.diagram[data-beat="2"] .link[data-step="3"] .wire i {
		animation-play-state: paused;
		opacity: 0;
	}

	.split {
		display: grid;
		grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
		gap: clamp(32px, 6vw, 88px);
		align-items: start;
		margin-top: clamp(48px, 6vw, 80px);
	}

	.points {
		display: grid;
		gap: 22px;
		padding: 0;
		list-style: none;
		font-size: 1.04rem;
		line-height: 1.65;
	}

	.points span {
		color: var(--muted);
	}

	.agents-title {
		margin-top: 44px;
	}

	.agents {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin-top: 16px;
		padding: 0;
		list-style: none;
	}

	.agents li {
		padding: 6px 13px;
		border-radius: 999px;
		background: var(--bg-raised);
		box-shadow: 0 0 0 1px var(--ring);
		font-size: 14.5px;
		font-weight: 600;
	}

	.note {
		margin-top: 16px;
		color: var(--muted);
		font-size: 14.5px;
		line-height: 1.65;
	}

	.panel :global(.frame) {
		width: 100%;
		border-radius: var(--radius);
		box-shadow:
			0 0 0 1px var(--ring),
			var(--shadow);
	}

	.panel figcaption {
		margin-top: 14px;
		color: var(--muted);
		font-size: 13.5px;
		line-height: 1.6;
	}

	@media (max-width: 900px) {
		.track {
			grid-template-columns: minmax(0, 1fr);
			justify-items: stretch;
		}

		/* 竖排：车道转成竖线 */
		.link {
			display: grid;
			grid-template-columns: 1fr 2px 1fr;
			align-items: center;
			gap: 14px;
			padding-block: 6px;
		}

		.link .top {
			text-align: right;
		}

		.link .bottom {
			text-align: left;
		}

		.wire {
			width: 2px;
			height: 56px;
			background-image: repeating-linear-gradient(180deg, var(--muted) 0 6px, transparent 6px 12px);
			background-size: 2px 12px;
			animation-name: march-down;
		}

		.live .wire {
			background-image: repeating-linear-gradient(180deg, var(--accent) 0 6px, transparent 6px 12px);
		}

		.wire::after {
			right: auto;
			top: auto;
			left: 50%;
			bottom: -2px;
			translate: -50% 0;
			rotate: 135deg;
		}

		.wire i {
			left: 50%;
			animation-name: packet-down;
		}

		@keyframes march-down {
			to {
				background-position: 0 12px;
			}
		}

		@keyframes packet-down {
			0% {
				top: 0;
				opacity: 0;
			}
			10% {
				opacity: 1;
			}
			80% {
				top: 100%;
				opacity: 1;
			}
			100% {
				top: 100%;
				opacity: 0;
			}
		}

		.split {
			grid-template-columns: minmax(0, 1fr);
		}

		.beats {
			grid-template-columns: minmax(0, 1fr);
		}

		.panel {
			max-width: 520px;
		}
	}
</style>
