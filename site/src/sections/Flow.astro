---
import type { Lang } from "../i18n";
import { localized } from "../media";
import { copy } from "./Flow.copy";

interface Props {
	lang: Lang;
}
const { lang } = Astro.props;
const t = copy[lang];
const AGENTS = ["Pi", "Claude Code", "Codex", "Grok", "Cursor", "Devin"];
---

<section class="section flow" id="how" aria-labelledby="how-title">
	<div class="section-inner">
		<p class="eyebrow">{t.eyebrow}</p>
		<h2 class="section-title" id="how-title" set:html={t.title} />
		<p class="section-lede">{t.lede}</p>

		<figure class="diagram dotted" aria-label={t.lede}>
			<div class="track">
				{
					t.stations.map((station, i) => (
						<>
							<div class:list={["station", { hub: i === 1 }]}>
								<span class="num">0{i + 1}</span>
								<strong>{station.name}</strong>
								<span class="meta">{station.meta}</span>
							</div>
							{i < t.links.length && (
								<div class:list={["link", { live: i === 0 }]} aria-hidden="true">
									<span class="top">{t.links[i].top}</span>
									<span class="wire">
										<i />
									</span>
									<span class="bottom">{t.links[i].bottom}</span>
								</div>
							)}
						</>
					))
				}
			</div>
			<figcaption class="back"><span aria-hidden="true">↺</span> {t.back}</figcaption>
		</figure>

		<div class="split">
			<div class="text">
				<ul class="points">
					{
						t.points.map((point) => (
							<li>
								<strong>{point.title}</strong> <span set:html={point.body} />
							</li>
						))
					}
				</ul>
				<h3 class="item-title agents-title">{t.agentsTitle}</h3>
				<ul class="agents">
					{AGENTS.map((name) => <li>{name}</li>)}
				</ul>
				<p class="note" set:html={t.agentsNote} />
			</div>
			<figure class="panel">
				<img src={localized("assets/live-panel.webp", lang)} alt={t.panelAlt} width="720" height="720" loading="lazy" decoding="async" />
				<figcaption>{t.panelCaption}</figcaption>
			</figure>
		</div>
	</div>
</section>

<style>
	.diagram {
		margin-top: clamp(40px, 5vw, 64px);
		padding: clamp(24px, 4vw, 48px);
		border-radius: var(--radius);
		background-color: var(--bg-raised);
		box-shadow: 0 0 0 1px var(--ring);
	}

	.track {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(120px, 0.8fr) minmax(0, 1fr) minmax(120px, 0.8fr) minmax(0, 1fr);
		align-items: center;
	}

	.station {
		display: flex;
		flex-direction: column;
		gap: 6px;
		padding: 20px 18px;
		border-radius: 14px;
		background: var(--bg);
		box-shadow:
			0 0 0 1.5px var(--fg),
			4px 4px 0 var(--faint);
		text-align: center;
	}

	.station.hub {
		box-shadow:
			0 0 0 1.5px var(--accent),
			4px 4px 0 color-mix(in oklch, var(--accent) 35%, transparent);
	}

	.num {
		color: var(--muted);
		font-family: var(--font-mono);
		font-size: 11.5px;
		letter-spacing: 0.12em;
	}

	.station strong {
		font-family: var(--font-display);
		font-size: 1.12rem;
		font-weight: 600;
		line-height: 1.25;
	}

	.meta {
		color: var(--muted);
		font-family: var(--font-mono);
		font-size: 11.5px;
		line-height: 1.5;
	}

	.link {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 8px;
		padding-inline: 10px;
		text-align: center;
	}

	.link .top {
		font-size: 13.5px;
		font-weight: 600;
	}

	.link.live .top {
		color: var(--accent);
	}

	.link .bottom {
		color: var(--muted);
		font-family: var(--font-mono);
		font-size: 11.5px;
	}

	/* 车道：虚线往前走，一个小包沿线跑过去 */
	.wire {
		position: relative;
		display: block;
		width: 100%;
		height: 2px;
		background: repeating-linear-gradient(90deg, var(--muted) 0 6px, transparent 6px 12px);
		background-size: 12px 2px;
		animation: march 900ms linear infinite;
	}

	.live .wire {
		background-image: repeating-linear-gradient(90deg, var(--accent) 0 6px, transparent 6px 12px);
	}

	.wire::after {
		content: "";
		position: absolute;
		right: -2px;
		top: 50%;
		width: 8px;
		height: 8px;
		border-top: 2px solid var(--muted);
		border-right: 2px solid var(--muted);
		translate: 0 -50%;
		rotate: 45deg;
	}

	.wire i {
		position: absolute;
		top: 50%;
		left: 0;
		width: 10px;
		height: 10px;
		border-radius: 50%;
		background: var(--amber);
		box-shadow: 0 0 10px var(--amber);
		translate: -50% -50%;
		animation: packet 2.4s var(--ease) infinite;
	}

	.link:nth-of-type(4) .wire i {
		animation-delay: 1.2s;
	}

	@keyframes march {
		to {
			background-position: 12px 0;
		}
	}

	@keyframes packet {
		0% {
			left: 0;
			opacity: 0;
		}
		10% {
			opacity: 1;
		}
		80% {
			left: 100%;
			opacity: 1;
		}
		100% {
			left: 100%;
			opacity: 0;
		}
	}

	.back {
		margin-top: 28px;
		padding-top: 20px;
		border-top: 1px dashed var(--faint);
		color: var(--muted);
		font-size: 14.5px;
		text-align: center;
		text-wrap: balance;
	}

	.back span {
		color: var(--accent);
		font-weight: 700;
	}

	.split {
		display: grid;
		grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
		gap: clamp(32px, 6vw, 88px);
		align-items: start;
		margin-top: clamp(48px, 6vw, 80px);
	}

	.points {
		display: grid;
		gap: 22px;
		padding: 0;
		list-style: none;
		font-size: 1.04rem;
		line-height: 1.65;
	}

	.points span {
		color: var(--muted);
	}

	.agents-title {
		margin-top: 44px;
	}

	.agents {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin-top: 16px;
		padding: 0;
		list-style: none;
	}

	.agents li {
		padding: 6px 13px;
		border-radius: 999px;
		background: var(--bg-raised);
		box-shadow: 0 0 0 1px var(--ring);
		font-size: 14.5px;
		font-weight: 600;
	}

	.note {
		margin-top: 16px;
		color: var(--muted);
		font-size: 14.5px;
		line-height: 1.65;
	}

	.panel img {
		width: 100%;
		border-radius: var(--radius);
		box-shadow:
			0 0 0 1px var(--ring),
			var(--shadow);
	}

	.panel figcaption {
		margin-top: 14px;
		color: var(--muted);
		font-size: 13.5px;
		line-height: 1.6;
	}

	@media (max-width: 900px) {
		.track {
			grid-template-columns: minmax(0, 1fr);
			justify-items: stretch;
		}

		/* 竖排：车道转成竖线 */
		.link {
			display: grid;
			grid-template-columns: 1fr 2px 1fr;
			align-items: center;
			gap: 14px;
			padding-block: 6px;
		}

		.link .top {
			text-align: right;
		}

		.link .bottom {
			text-align: left;
		}

		.wire {
			width: 2px;
			height: 56px;
			background-image: repeating-linear-gradient(180deg, var(--muted) 0 6px, transparent 6px 12px);
			background-size: 2px 12px;
			animation-name: march-down;
		}

		.live .wire {
			background-image: repeating-linear-gradient(180deg, var(--accent) 0 6px, transparent 6px 12px);
		}

		.wire::after {
			right: auto;
			top: auto;
			left: 50%;
			bottom: -2px;
			translate: -50% 0;
			rotate: 135deg;
		}

		.wire i {
			left: 50%;
			animation-name: packet-down;
		}

		@keyframes march-down {
			to {
				background-position: 0 12px;
			}
		}

		@keyframes packet-down {
			0% {
				top: 0;
				opacity: 0;
			}
			10% {
				opacity: 1;
			}
			80% {
				top: 100%;
				opacity: 1;
			}
			100% {
				top: 100%;
				opacity: 0;
			}
		}

		.split {
			grid-template-columns: minmax(0, 1fr);
		}

		.panel {
			max-width: 520px;
		}
	}
</style>
